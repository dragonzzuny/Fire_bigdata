# 이 파일을 .env 로 복사하고 본인 키를 채운다.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KMA_API_HUB_KEY=

# 공공데이터포털 서비스 키 (선택).
# 있으면 관리대장 서식의 연면적·건축면적·건축연도가 건축물대장에서 채워진다.
# 없으면 그 칸은 비고 '건축물대장 미연계'로 남는다 — 동작에는 지장이 없다.
# 신청: https://www.data.go.kr/data/15044713/openapi.do
#       (국토교통부_건축물대장정보 서비스, 무료·즉시 승인)
# 주의: 포털이 주는 '일반 인증키(Decoding)' 를 그대로 넣는다.
DATA_GO_KR_KEY=

# 통계청 SGIS (선택). 있으면 대응취약 구역에 읍면동 상주인구가 붙는다.
# 서식의 '상주인구' 칸에는 쓰지 않는다 — OpenAPI 는 읍면동까지만 주는데
# 그 값을 격자에 쓰면 한 동의 인구가 여러 번 세어진다.
# 신청: https://sgis.kostat.go.kr/developer/  (서비스 등록 후 즉시 발급)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
